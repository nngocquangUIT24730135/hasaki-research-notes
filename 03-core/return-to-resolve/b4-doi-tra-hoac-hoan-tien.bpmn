<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_B4_L2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_B4">
    <bpmn:participant id="Pool_Customer" name="Khách hàng" processRef="Process_Customer" />
    <bpmn:participant id="Pool_Hasaki" name="Hasaki" processRef="Process_Hasaki" />
    <bpmn:messageFlow id="MF_WalkIn" name="Mang sản phẩm tới cửa hàng" sourceRef="T_C_BringDirect" targetRef="SE_H" />
    <bpmn:messageFlow id="MF_Contact" name="Liên hệ tổng đài / fanpage" sourceRef="T_C_Contact" targetRef="SE_H" />
    <bpmn:messageFlow id="MF_Guide" name="Hướng dẫn mang tới CH hoặc gửi hàng về đâu" sourceRef="T_H_Guide" targetRef="T_C_ReceiveGuide" />
    <bpmn:messageFlow id="MF_BringAfter" name="Mang sản phẩm tới cửa hàng theo hướng dẫn" sourceRef="T_C_BringAfter" targetRef="T_H_ReceiveStoreAfter" />
    <bpmn:messageFlow id="MF_Ship" name="Gửi hàng theo địa chỉ Hasaki chỉ định" sourceRef="T_C_Ship" targetRef="T_H_ReceiveMail" />
    <bpmn:messageFlow id="MF_ProposePlan" name="Đề xuất phương án giải quyết" sourceRef="T_H_ConfirmPlan" targetRef="T_C_ConfirmPlan" />
    <bpmn:messageFlow id="MF_AgreePlan" name="Xác nhận đồng ý phương án giải quyết" sourceRef="T_C_ConfirmPlan" targetRef="T_H_ConfirmPlan" />
    <bpmn:messageFlow id="MF_Reject" name="Thông báo không hỗ trợ đổi trả" sourceRef="T_H_Explain" targetRef="T_C_GetReject" />
    <bpmn:messageFlow id="MF_Refund" name="Hoàn tiền" sourceRef="T_H_Refund" targetRef="T_C_GetRefund" />
    <bpmn:messageFlow id="MF_Exchange" name="Giao / gửi sản phẩm mới hoặc thay thế" sourceRef="T_H_Issue" targetRef="T_C_GetExchange" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" name="Yêu cầu đổi trả" isExecutable="false">
    <bpmn:startEvent id="SE_C" name="Nhu cầu đổi trả phát sinh">
      <bpmn:outgoing>SF_C_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="X_C1" name="Mang tới cửa hàng luôn hay liên hệ trước?" default="SF_C_WalkIn">
      <bpmn:incoming>SF_C_1</bpmn:incoming>
      <bpmn:outgoing>SF_C_WalkIn</bpmn:outgoing>
      <bpmn:outgoing>SF_C_Contact</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_C_BringDirect" name="Mang sản phẩm đến cửa hàng Hasaki">
      <bpmn:incoming>SF_C_WalkIn</bpmn:incoming>
      <bpmn:outgoing>SF_C_Join1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_C_Contact" name="Liên hệ tổng đài / fanpage để đổi trả online">
      <bpmn:incoming>SF_C_Contact</bpmn:incoming>
      <bpmn:outgoing>SF_C_AfterContact</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_C_ReceiveGuide" name="Nhận hướng dẫn bước tiếp theo từ Hasaki">
      <bpmn:incoming>SF_C_AfterContact</bpmn:incoming>
      <bpmn:outgoing>SF_C_AfterGuide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="X_C2" name="Mang tới cửa hàng hay gửi hàng?" default="SF_C_BringAfter">
      <bpmn:incoming>SF_C_AfterGuide</bpmn:incoming>
      <bpmn:outgoing>SF_C_BringAfter</bpmn:outgoing>
      <bpmn:outgoing>SF_C_Ship</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_C_BringAfter" name="Đồng ý mang sản phẩm đến cửa hàng">
      <bpmn:incoming>SF_C_BringAfter</bpmn:incoming>
      <bpmn:outgoing>SF_C_Join2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_C_Ship" name="Gửi hàng theo hướng dẫn của Hasaki">
      <bpmn:incoming>SF_C_Ship</bpmn:incoming>
      <bpmn:outgoing>SF_C_Join3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_C_JoinChannel" name="">
      <bpmn:incoming>SF_C_Join1</bpmn:incoming>
      <bpmn:incoming>SF_C_Join2</bpmn:incoming>
      <bpmn:incoming>SF_C_Join3</bpmn:incoming>
      <bpmn:outgoing>SF_C_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_C_WaitReceive" name="Chờ Hasaki nhận và kiểm sản phẩm">
      <bpmn:incoming>SF_C_Wait</bpmn:incoming>
      <bpmn:outgoing>SF_C_ToConfirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_C_ConfirmPlan" name="Xác nhận phương án giải quyết với Hasaki">
      <bpmn:incoming>SF_C_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>SF_C_ToOutcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="X_C3" name="Phương án đã thống nhất?" default="SF_C_Reject">
      <bpmn:incoming>SF_C_ToOutcome</bpmn:incoming>
      <bpmn:outgoing>SF_C_Reject</bpmn:outgoing>
      <bpmn:outgoing>SF_C_Refund</bpmn:outgoing>
      <bpmn:outgoing>SF_C_Exchange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_C_GetReject" name="Nhận thông báo không hỗ trợ">
      <bpmn:incoming>SF_C_Reject</bpmn:incoming>
      <bpmn:outgoing>SF_C_EndReject</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_C_GetRefund" name="Nhận tiền hoàn">
      <bpmn:incoming>SF_C_Refund</bpmn:incoming>
      <bpmn:outgoing>SF_C_EndRefund</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_C_GetExchange" name="Nhận sản phẩm mới / sản phẩm thay thế">
      <bpmn:incoming>SF_C_Exchange</bpmn:incoming>
      <bpmn:outgoing>SF_C_EndExchange</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_C_Reject" name="Không được đổi trả">
      <bpmn:incoming>SF_C_EndReject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_C_Refund" name="Hoàn tiền xong">
      <bpmn:incoming>SF_C_EndRefund</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_C_Exchange" name="Đổi hàng xong">
      <bpmn:incoming>SF_C_EndExchange</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_C_1" sourceRef="SE_C" targetRef="X_C1" />
    <bpmn:sequenceFlow id="SF_C_WalkIn" name="(a) Mang tới cửa hàng luôn" sourceRef="X_C1" targetRef="T_C_BringDirect" />
    <bpmn:sequenceFlow id="SF_C_Contact" name="(b) Liên hệ tổng đài / fanpage" sourceRef="X_C1" targetRef="T_C_Contact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kenhBatDau = "lien_he"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_C_AfterContact" sourceRef="T_C_Contact" targetRef="T_C_ReceiveGuide" />
    <bpmn:sequenceFlow id="SF_C_AfterGuide" sourceRef="T_C_ReceiveGuide" targetRef="X_C2" />
    <bpmn:sequenceFlow id="SF_C_BringAfter" name="(b1) Mang tới cửa hàng" sourceRef="X_C2" targetRef="T_C_BringAfter" />
    <bpmn:sequenceFlow id="SF_C_Ship" name="(b2) Gửi hàng theo hướng dẫn" sourceRef="X_C2" targetRef="T_C_Ship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kenhSauHuongDan = "gui_hang"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_C_Join1" sourceRef="T_C_BringDirect" targetRef="GW_C_JoinChannel" />
    <bpmn:sequenceFlow id="SF_C_Join2" sourceRef="T_C_BringAfter" targetRef="GW_C_JoinChannel" />
    <bpmn:sequenceFlow id="SF_C_Join3" sourceRef="T_C_Ship" targetRef="GW_C_JoinChannel" />
    <bpmn:sequenceFlow id="SF_C_Wait" sourceRef="GW_C_JoinChannel" targetRef="T_C_WaitReceive" />
    <bpmn:sequenceFlow id="SF_C_ToConfirm" sourceRef="T_C_WaitReceive" targetRef="T_C_ConfirmPlan" />
    <bpmn:sequenceFlow id="SF_C_ToOutcome" sourceRef="T_C_ConfirmPlan" targetRef="X_C3" />
    <bpmn:sequenceFlow id="SF_C_Reject" name="Không hỗ trợ" sourceRef="X_C3" targetRef="T_C_GetReject" />
    <bpmn:sequenceFlow id="SF_C_Refund" name="Chốt hoàn tiền" sourceRef="X_C3" targetRef="T_C_GetRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=phuongAn = "hoan_tien"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_C_Exchange" name="Chốt nhận sản phẩm thay thế" sourceRef="X_C3" targetRef="T_C_GetExchange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=phuongAn = "doi_hang"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_C_EndReject" sourceRef="T_C_GetReject" targetRef="EE_C_Reject" />
    <bpmn:sequenceFlow id="SF_C_EndRefund" sourceRef="T_C_GetRefund" targetRef="EE_C_Refund" />
    <bpmn:sequenceFlow id="SF_C_EndExchange" sourceRef="T_C_GetExchange" targetRef="EE_C_Exchange" />
  </bpmn:process>
  <bpmn:process id="Process_Hasaki" name="Đổi trả hoặc hoàn tiền" isExecutable="false">
    <bpmn:laneSet id="LS_Hasaki">
      <bpmn:lane id="Lane_Front" name="NV cửa hàng / CSKH">
        <bpmn:flowNodeRef>SE_H</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_IntakeWalkIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_ReceiveStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_IntakeContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_Guide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_ReceiveStoreAfter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_H_JoinReceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_ConfirmPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_Explain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_H_Reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Wh" name="Kho">
        <bpmn:flowNodeRef>T_H_ReceiveMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_H_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_H_Exchange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Acc" name="Kế toán / Hoàn tiền">
        <bpmn:flowNodeRef>T_H_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_H_Refund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_H" name="Yêu cầu đổi trả được tiếp nhận">
      <bpmn:outgoing>SF_H_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="X0" name="Walk-in hay liên hệ trước?" default="SF_H_WalkIn">
      <bpmn:incoming>SF_H_1</bpmn:incoming>
      <bpmn:outgoing>SF_H_WalkIn</bpmn:outgoing>
      <bpmn:outgoing>SF_H_Contact</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_H_IntakeWalkIn" name="Tiếp nhận khách mang hàng tới cửa hàng">
      <bpmn:incoming>SF_H_WalkIn</bpmn:incoming>
      <bpmn:outgoing>SF_H_WalkIn2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_ReceiveStore" name="Nhận và kiểm sản phẩm tại cửa hàng">
      <bpmn:incoming>SF_H_WalkIn2</bpmn:incoming>
      <bpmn:outgoing>SF_H_Join1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_IntakeContact" name="Ghi nhận yêu cầu qua tổng đài / fanpage">
      <bpmn:incoming>SF_H_Contact</bpmn:incoming>
      <bpmn:outgoing>SF_H_Guide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_Guide" name="Xác nhận lý do và hướng dẫn bước tiếp theo">
      <bpmn:incoming>SF_H_Guide</bpmn:incoming>
      <bpmn:outgoing>SF_H_ToX1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="X1" name="Khách mang tới CH hay gửi hàng?" default="SF_H_StoreAfter">
      <bpmn:incoming>SF_H_ToX1</bpmn:incoming>
      <bpmn:outgoing>SF_H_StoreAfter</bpmn:outgoing>
      <bpmn:outgoing>SF_H_Mail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_H_ReceiveStoreAfter" name="Nhận và kiểm sản phẩm tại cửa hàng">
      <bpmn:incoming>SF_H_StoreAfter</bpmn:incoming>
      <bpmn:outgoing>SF_H_Join2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_ReceiveMail" name="Nhận và kiểm hàng khách gửi về">
      <bpmn:incoming>SF_H_Mail</bpmn:incoming>
      <bpmn:outgoing>SF_H_Join3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_H_JoinReceive" name="">
      <bpmn:incoming>SF_H_Join1</bpmn:incoming>
      <bpmn:incoming>SF_H_Join2</bpmn:incoming>
      <bpmn:incoming>SF_H_Join3</bpmn:incoming>
      <bpmn:outgoing>SF_H_Assess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_H_Assess" name="Xét điều kiện đổi trả theo chính sách">
      <bpmn:incoming>SF_H_Assess</bpmn:incoming>
      <bpmn:outgoing>SF_H_Confirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_ConfirmPlan" name="Xác nhận phương án giải quyết với khách hàng">
      <bpmn:incoming>SF_H_Confirm</bpmn:incoming>
      <bpmn:outgoing>SF_H_ToX2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="X2" name="Phương án đã thống nhất?" default="SF_H_Reject">
      <bpmn:incoming>SF_H_ToX2</bpmn:incoming>
      <bpmn:outgoing>SF_H_Reject</bpmn:outgoing>
      <bpmn:outgoing>SF_H_Refund</bpmn:outgoing>
      <bpmn:outgoing>SF_H_Exchange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_H_Explain" name="Giải thích lý do không hỗ trợ">
      <bpmn:incoming>SF_H_Reject</bpmn:incoming>
      <bpmn:outgoing>SF_H_EndReject</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_Refund" name="Thực hiện hoàn tiền">
      <bpmn:incoming>SF_H_Refund</bpmn:incoming>
      <bpmn:outgoing>SF_H_EndRefund</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_H_Issue" name="Giao / gửi sản phẩm mới hoặc thay thế">
      <bpmn:incoming>SF_H_Exchange</bpmn:incoming>
      <bpmn:outgoing>SF_H_EndExchange</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_H_Reject" name="Không hỗ trợ đổi trả">
      <bpmn:incoming>SF_H_EndReject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_H_Refund" name="Hoàn tiền hoàn tất">
      <bpmn:incoming>SF_H_EndRefund</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_H_Exchange" name="Đổi hàng hoàn tất">
      <bpmn:incoming>SF_H_EndExchange</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_H_1" sourceRef="SE_H" targetRef="X0" />
    <bpmn:sequenceFlow id="SF_H_WalkIn" name="Walk-in" sourceRef="X0" targetRef="T_H_IntakeWalkIn" />
    <bpmn:sequenceFlow id="SF_H_Contact" name="Liên hệ trước" sourceRef="X0" targetRef="T_H_IntakeContact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kenhBatDau = "lien_he"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_H_WalkIn2" sourceRef="T_H_IntakeWalkIn" targetRef="T_H_ReceiveStore" />
    <bpmn:sequenceFlow id="SF_H_Join1" sourceRef="T_H_ReceiveStore" targetRef="GW_H_JoinReceive" />
    <bpmn:sequenceFlow id="SF_H_Guide" sourceRef="T_H_IntakeContact" targetRef="T_H_Guide" />
    <bpmn:sequenceFlow id="SF_H_ToX1" sourceRef="T_H_Guide" targetRef="X1" />
    <bpmn:sequenceFlow id="SF_H_StoreAfter" name="Mang tới cửa hàng" sourceRef="X1" targetRef="T_H_ReceiveStoreAfter" />
    <bpmn:sequenceFlow id="SF_H_Mail" name="Gửi hàng online" sourceRef="X1" targetRef="T_H_ReceiveMail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kenhSauHuongDan = "gui_hang"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_H_Join2" sourceRef="T_H_ReceiveStoreAfter" targetRef="GW_H_JoinReceive" />
    <bpmn:sequenceFlow id="SF_H_Join3" sourceRef="T_H_ReceiveMail" targetRef="GW_H_JoinReceive" />
    <bpmn:sequenceFlow id="SF_H_Assess" sourceRef="GW_H_JoinReceive" targetRef="T_H_Assess" />
    <bpmn:sequenceFlow id="SF_H_Confirm" sourceRef="T_H_Assess" targetRef="T_H_ConfirmPlan" />
    <bpmn:sequenceFlow id="SF_H_ToX2" sourceRef="T_H_ConfirmPlan" targetRef="X2" />
    <bpmn:sequenceFlow id="SF_H_Reject" name="Không hỗ trợ" sourceRef="X2" targetRef="T_H_Explain" />
    <bpmn:sequenceFlow id="SF_H_Refund" name="Hoàn tiền" sourceRef="X2" targetRef="T_H_Refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=phuongAn = "hoan_tien"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_H_Exchange" name="Đổi / sản phẩm thay thế" sourceRef="X2" targetRef="T_H_Issue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=phuongAn = "doi_hang"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF_H_EndReject" sourceRef="T_H_Explain" targetRef="EE_H_Reject" />
    <bpmn:sequenceFlow id="SF_H_EndRefund" sourceRef="T_H_Refund" targetRef="EE_H_Refund" />
    <bpmn:sequenceFlow id="SF_H_EndExchange" sourceRef="T_H_Issue" targetRef="EE_H_Exchange" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_B4">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_B4" bpmnElement="Collab_B4">
      <bpmndi:BPMNShape id="Pool_Customer_di" bpmnElement="Pool_Customer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1926" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SE_C_di" bpmnElement="SE_C">
        <dc:Bounds x="60" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_C1_di" bpmnElement="X_C1">
        <dc:Bounds x="203" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_C_BringDirect_di" bpmnElement="T_C_BringDirect">
        <dc:Bounds x="328" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_C_JoinChannel_di" bpmnElement="GW_C_JoinChannel">
        <dc:Bounds x="503" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_C_WaitReceive_di" bpmnElement="T_C_WaitReceive">
        <dc:Bounds x="628" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
