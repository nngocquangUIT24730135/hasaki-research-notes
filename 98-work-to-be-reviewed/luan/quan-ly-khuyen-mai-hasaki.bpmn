<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_QuanLyKhuyenMaiHasaki" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <bpmn:collaboration id="Collaboration_QuanLyKhuyenMai">
    <bpmn:participant id="Participant_Hasaki" name="Hasaki" processRef="Process_QuanLyKhuyenMai" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QuanLyKhuyenMai" name="Quản lý chương trình khuyến mãi tại Hasaki, từ đề xuất đến đánh giá hiệu quả" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hasaki">
      <bpmn:lane id="Lane_Marketing" name="Marketing">
        <bpmn:flowNodeRef>Task_AnalyzeNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefinePromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProposalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdjustmentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_PromotionNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0a5ku5f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ReviewApproval" name="Thẩm định và phê duyệt">
        <bpmn:flowNodeRef>Task_ReviewApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProcessCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CategorySuitable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinancialPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFinancial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCategoryStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MonitorJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PeriodExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ThresholdReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResponseDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProposalRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITSystem" name="CNTT / Hệ thống">
        <bpmn:flowNodeRef>Gateway_TestMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestPromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixConfiguration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivatePromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MonitorCycleMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MonitorSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorRevenueBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CloseMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClosePromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfigurePromotion</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_DecideResponse" targetRef="Gateway_ResponseDecision" />
    <bpmn:sequenceFlow id="Flow_ThresholdReached" name="Có" sourceRef="Gateway_ThresholdReached" targetRef="Task_DecideResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${thresholdReached == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PeriodNotExpired" name="Chưa" sourceRef="Gateway_PeriodExpired" targetRef="Gateway_ThresholdReached" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_MonitorJoin" targetRef="Gateway_PeriodExpired" />
    <bpmn:sequenceFlow id="Flow_StockToJoin" sourceRef="Task_MonitorInventory" targetRef="Gateway_MonitorJoin" />
    <bpmn:sequenceFlow id="Flow_ResponseAdjust" name="Điều chỉnh" sourceRef="Gateway_ResponseDecision" targetRef="Gateway_0a5ku5f">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${response == "ADJUST"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CreateProposal" targetRef="Task_CheckCategoryStock" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckFinancial" targetRef="Gateway_FinancialPassed" />
    <bpmn:sequenceFlow id="Flow_CategorySuitable" name="Phù hợp" sourceRef="Gateway_CategorySuitable" targetRef="Task_CheckFinancial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${categoryAndStockSuitable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CheckCategoryStock" targetRef="Gateway_CategorySuitable" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ReviewReport" targetRef="End_ProcessCompleted" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PrepareReport" targetRef="Task_ReviewReport" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CompileResults" targetRef="Task_PrepareReport" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ClosePromotion" targetRef="Task_CompileResults" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_CloseMerge" targetRef="Task_ClosePromotion" />
    <bpmn:sequenceFlow id="Flow_ResponseStop" name="Dừng" sourceRef="Gateway_ResponseDecision" targetRef="Gateway_CloseMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${response == "STOP"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PeriodExpired" name="Có" sourceRef="Gateway_PeriodExpired" targetRef="Gateway_CloseMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${periodExpired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceToJoin" sourceRef="Task_MonitorRevenueBudget" targetRef="Gateway_MonitorJoin" />
    <bpmn:sequenceFlow id="Flow_MonitorStock" sourceRef="Gateway_MonitorSplit" targetRef="Task_MonitorInventory" />
    <bpmn:sequenceFlow id="Flow_MonitorFinance" sourceRef="Gateway_MonitorSplit" targetRef="Task_MonitorRevenueBudget" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_MonitorCycleMerge" targetRef="Gateway_MonitorSplit" />
    <bpmn:sequenceFlow id="Flow_ResponseContinue" name="Tiếp tục" sourceRef="Gateway_ResponseDecision" targetRef="Gateway_MonitorCycleMerge" />
    <bpmn:sequenceFlow id="Flow_ThresholdNotReached" name="Không" sourceRef="Gateway_ThresholdReached" targetRef="Gateway_MonitorCycleMerge" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ActivatePromotion" targetRef="Gateway_MonitorCycleMerge" />
    <bpmn:sequenceFlow id="Flow_TestFailed" name="Không đạt" sourceRef="Gateway_TestPassed" targetRef="Task_FixConfiguration" />
    <bpmn:sequenceFlow id="Flow_TestPassed" name="Đạt" sourceRef="Gateway_TestPassed" targetRef="Task_ActivatePromotion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${testPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_TestPromotion" targetRef="Gateway_TestPassed" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_TestMerge" targetRef="Task_TestPromotion" />
    <bpmn:sequenceFlow id="Flow_FixToTest" sourceRef="Task_FixConfiguration" targetRef="Gateway_TestMerge" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ConfigurePromotion" targetRef="Gateway_TestMerge" />
    <bpmn:sequenceFlow id="Flow_AdjustmentMerge" sourceRef="Gateway_AdjustmentMerge" targetRef="Task_AdjustProposal" />
    <bpmn:sequenceFlow id="Flow_1eaju0t" sourceRef="Gateway_0a5ku5f" targetRef="Gateway_AdjustmentMerge" />
    <bpmn:sequenceFlow id="Flow_FinancialFailed" name="Không đạt" sourceRef="Gateway_FinancialPassed" targetRef="Gateway_AdjustmentMerge" />
    <bpmn:sequenceFlow id="Flow_CategoryNotSuitable" name="Không phù hợp" sourceRef="Gateway_CategorySuitable" targetRef="Gateway_AdjustmentMerge" />
    <bpmn:sequenceFlow id="Flow_ApprovalRejected" name="Từ chối" sourceRef="Gateway_ApprovalDecision" targetRef="End_ProposalRejected" />
    <bpmn:sequenceFlow id="Flow_ApprovalRevision" name="Yêu cầu điều chỉnh" sourceRef="Gateway_ApprovalDecision" targetRef="Gateway_0a5ku5f">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalResult == "REVISION"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalGranted" name="Phê duyệt" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ConfigurePromotion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalResult == "APPROVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ReviewApproval" targetRef="Gateway_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_FinancialPassed" name="Đạt" sourceRef="Gateway_FinancialPassed" targetRef="Task_ReviewApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${financialPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_ProposalMerge" targetRef="Task_CreateProposal" />
    <bpmn:sequenceFlow id="Flow_AdjustToProposal" sourceRef="Task_AdjustProposal" targetRef="Gateway_ProposalMerge" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DefinePromotion" targetRef="Gateway_ProposalMerge" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AnalyzeNeed" targetRef="Task_DefinePromotion" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_PromotionNeed" targetRef="Task_AnalyzeNeed" />
    <bpmn:task id="Task_ConfigurePromotion" name="Cấu hình chương trình khuyến mãi">
      <bpmn:incoming>Flow_ApprovalGranted</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ProposalRejected" name="Đề xuất bị từ chối">
      <bpmn:incoming>Flow_ApprovalRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ResponseDecision" name="Phương án được chọn?" default="Flow_ResponseContinue">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_ResponseAdjust</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResponseStop</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResponseContinue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DecideResponse" name="Quyết định phương án xử lý">
      <bpmn:incoming>Flow_ThresholdReached</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ThresholdReached" name="Ngân sách hoặc tồn kho chạm ngưỡng?" default="Flow_ThresholdNotReached">
      <bpmn:incoming>Flow_PeriodNotExpired</bpmn:incoming>
      <bpmn:outgoing>Flow_ThresholdReached</bpmn:outgoing>
      <bpmn:outgoing>Flow_ThresholdNotReached</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PeriodExpired" name="Chương trình đã hết thời hạn?" default="Flow_PeriodNotExpired">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_PeriodExpired</bpmn:outgoing>
      <bpmn:outgoing>Flow_PeriodNotExpired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_MonitorJoin">
      <bpmn:incoming>Flow_FinanceToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_StockToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_MonitorInventory" name="Theo dõi tồn kho và tình trạng chương trình">
      <bpmn:incoming>Flow_MonitorStock</bpmn:incoming>
      <bpmn:outgoing>Flow_StockToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_0a5ku5f">
      <bpmn:incoming>Flow_ResponseAdjust</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalRevision</bpmn:incoming>
      <bpmn:outgoing>Flow_1eaju0t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustProposal" name="Điều chỉnh đề xuất khuyến mãi">
      <bpmn:incoming>Flow_AdjustmentMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_AdjustToProposal</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckCategoryStock" name="Kiểm tra danh mục và tồn kho dự kiến">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateProposal" name="Lập đề xuất khuyến mãi">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckFinancial" name="Thẩm định ngân sách, giá bán và biên lợi nhuận">
      <bpmn:incoming>Flow_CategorySuitable</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_FinancialPassed" name="Yêu cầu tài chính đạt?" default="Flow_FinancialFailed">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_FinancialPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinancialFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CategorySuitable" name="Danh mục và tồn kho phù hợp?" default="Flow_CategoryNotSuitable">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_CategorySuitable</bpmn:outgoing>
      <bpmn:outgoing>Flow_CategoryNotSuitable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareReport" name="Lập báo cáo đánh giá hiệu quả">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Start_PromotionNeed" name="Phát sinh nhu cầu khuyến mãi">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_ProcessCompleted" name="Hoàn thành đánh giá chương trình">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ReviewReport" name="Xem xét báo cáo đánh giá">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompileResults" name="Tổng hợp kết quả chương trình">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ClosePromotion" name="Đóng chương trình khuyến mãi">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CloseMerge">
      <bpmn:incoming>Flow_PeriodExpired</bpmn:incoming>
      <bpmn:incoming>Flow_ResponseStop</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_MonitorRevenueBudget" name="Theo dõi doanh thu và ngân sách">
      <bpmn:incoming>Flow_MonitorFinance</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_MonitorSplit">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_MonitorFinance</bpmn:outgoing>
      <bpmn:outgoing>Flow_MonitorStock</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_MonitorCycleMerge">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_ThresholdNotReached</bpmn:incoming>
      <bpmn:incoming>Flow_ResponseContinue</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ActivatePromotion" name="Kích hoạt chương trình khuyến mãi">
      <bpmn:incoming>Flow_TestPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FixConfiguration" name="Sửa cấu hình chương trình">
      <bpmn:incoming>Flow_TestFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_FixToTest</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TestPassed" name="Kết quả kiểm thử đạt?" default="Flow_TestFailed">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_TestPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_TestFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TestPromotion" name="Kiểm thử giá, thời gian, sản phẩm và điều kiện">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TestMerge">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_FixToTest</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AdjustmentMerge">
      <bpmn:incoming>Flow_CategoryNotSuitable</bpmn:incoming>
      <bpmn:incoming>Flow_FinancialFailed</bpmn:incoming>
      <bpmn:incoming>Flow_1eaju0t</bpmn:incoming>
      <bpmn:outgoing>Flow_AdjustmentMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Kết quả phê duyệt?" default="Flow_ApprovalRejected">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalGranted</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRevision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviewApproval" name="Xem xét phê duyệt đề xuất">
      <bpmn:incoming>Flow_FinancialPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ProposalMerge">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_AdjustToProposal</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DefinePromotion" name="Xác định mục tiêu và điều kiện khuyến mãi">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AnalyzeNeed" name="Phân tích nhu cầu khuyến mãi">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_QuanLyKhuyenMai">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_QuanLyKhuyenMai" bpmnElement="Collaboration_QuanLyKhuyenMai">
      <bpmndi:BPMNShape id="Participant_Hasaki_di" bpmnElement="Participant_Hasaki" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="4090" height="930" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ITSystem_di" bpmnElement="Lane_ITSystem" isHorizontal="true">
        <dc:Bounds x="190" y="690" width="4060" height="320" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ReviewApproval_di" bpmnElement="Lane_ReviewApproval" isHorizontal="true">
        <dc:Bounds x="190" y="390" width="4060" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Marketing_di" bpmnElement="Lane_Marketing" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="4060" height="310" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AnalyzeNeed_di" bpmnElement="Task_AnalyzeNeed">
        <dc:Bounds x="330" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DefinePromotion_di" bpmnElement="Task_DefinePromotion">
        <dc:Bounds x="480" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ProposalMerge_di" bpmnElement="Gateway_ProposalMerge" isMarkerVisible="true">
        <dc:Bounds x="650" y="175" width="50" height="50" />
