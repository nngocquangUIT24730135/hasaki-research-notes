<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HasakiVanChuyen2H" targetNamespace="http://hasaki.vn/bpmn/van-chuyen-2h">
  <bpmn:collaboration id="Collab_VanChuyen2H">
    <bpmn:participant id="Pool_KhachHang" name="Khách hàng" processRef="Process_KhachHang" />
    <bpmn:participant id="Pool_Hasaki" name="Hasaki — Quy trình giao hàng 2H" processRef="Process_Hasaki" />
    <bpmn:messageFlow id="Msg_DatHang" name="Đơn hàng 2H" sourceRef="Task_KH_DatHang" targetRef="Start_DonHang2H" />
    <bpmn:messageFlow id="Msg_GoiXacNhan" name="Gọi xác nhận địa chỉ &#38; giờ giao" sourceRef="Task_GoiXacNhan" targetRef="Event_KH_NhanCuocGoi" />
    <bpmn:messageFlow id="Msg_BaoHetHang" name="Thông báo hết hàng / hủy" sourceRef="Task_XuLyHetHang" targetRef="Event_KH_NhanThongBao" />
    <bpmn:messageFlow id="Msg_GiaoHang" name="Giao hàng" sourceRef="Task_GiaoHang" targetRef="Event_KH_NhanHang" />
    <bpmn:messageFlow id="Msg_LienLacGiao" name="Liên hệ giao hàng" sourceRef="Task_GiaoHang" targetRef="Event_KH_ShipperGoi" />
    <bpmn:messageFlow id="Msg_HenGiaoLai" name="Hẹn giao lại" sourceRef="Task_LienHeHenGiaoLai" targetRef="Event_KH_HenGiaoLai" />
    <bpmn:messageFlow id="Msg_HuyHoanTien" name="Thông báo hủy đơn &#38; hoàn tiền" sourceRef="Task_HuyVaHoanTien" targetRef="Event_KH_HuyHoanTien" />
    <bpmn:messageFlow id="Msg_Phieu100K" name="Cộng phiếu 100K vào tài khoản" sourceRef="Task_CapPhieu100K" targetRef="Task_KH_NhanPhieu" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KhachHang" name="Khách hàng" isExecutable="false">
    <bpmn:startEvent id="Start_KH" name="Muốn nhận hàng nhanh trong ngày" />
    <bpmn:task id="Task_KH_DatHang" name="Đặt đơn hàng 2H trên App" />
    <bpmn:eventBasedGateway id="Gw_KH_ChoPhanHoi" name="Chờ phản hồi từ Hasaki" />
    <bpmn:intermediateCatchEvent id="Event_KH_NhanCuocGoi" name="Nhận cuộc gọi xác nhận địa chỉ &#38; giờ giao">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_KH_NhanThongBao" name="Nhận thông báo hết hàng / hủy">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_KH_TraLoiCuocGoi" name="Xác nhận địa chỉ/giờ hoặc hẹn lại muộn hơn" />
    <bpmn:eventBasedGateway id="Gw_KH_ChoGiao" name="Chờ giao hàng" />
    <bpmn:intermediateCatchEvent id="Event_KH_ShipperGoi" name="Shipper liên hệ (không nhận được lần này)">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gw_KH_ChoSauThatBai" name="Chờ xử lý sau giao thất bại" />
    <bpmn:intermediateCatchEvent id="Event_KH_HenGiaoLai" name="Nhận lịch hẹn giao lại">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_KH_HuyHoanTien" name="Nhận thông báo hủy &#38; hoàn tiền">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_KH_NhanHang" name="Nhận hàng thành công">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_KH_CoPhieu" name="Tài khoản được cộng phiếu 100K?" default="Flow_KH_KhongPhieu" />
    <bpmn:task id="Task_KH_NhanPhieu" name="Nhận phiếu 100K trên tài khoản App/Website" />
    <bpmn:endEvent id="End_KH_ThanhCong" name="Hoàn tất đơn 2H" />
    <bpmn:endEvent id="End_KH_Huy" name="Đơn bị hủy" />
    <bpmn:endEvent id="End_KH_HuyHoanTien" name="Đơn hủy — đã được hoàn tiền" />
    <bpmn:sequenceFlow id="Flow_KH_1" sourceRef="Start_KH" targetRef="Task_KH_DatHang" />
    <bpmn:sequenceFlow id="Flow_KH_2" sourceRef="Task_KH_DatHang" targetRef="Gw_KH_ChoPhanHoi" />
    <bpmn:sequenceFlow id="Flow_KH_3" sourceRef="Gw_KH_ChoPhanHoi" targetRef="Event_KH_NhanCuocGoi" />
    <bpmn:sequenceFlow id="Flow_KH_4" sourceRef="Gw_KH_ChoPhanHoi" targetRef="Event_KH_NhanThongBao" />
    <bpmn:sequenceFlow id="Flow_KH_5" sourceRef="Event_KH_NhanThongBao" targetRef="End_KH_Huy" />
    <bpmn:sequenceFlow id="Flow_KH_6" sourceRef="Event_KH_NhanCuocGoi" targetRef="Task_KH_TraLoiCuocGoi" />
    <bpmn:sequenceFlow id="Flow_KH_7" sourceRef="Task_KH_TraLoiCuocGoi" targetRef="Gw_KH_ChoGiao" />
    <bpmn:sequenceFlow id="Flow_KH_8" sourceRef="Gw_KH_ChoGiao" targetRef="Event_KH_ShipperGoi" />
    <bpmn:sequenceFlow id="Flow_KH_9" sourceRef="Gw_KH_ChoGiao" targetRef="Event_KH_NhanHang" />
    <bpmn:sequenceFlow id="Flow_KH_10" sourceRef="Event_KH_ShipperGoi" targetRef="Gw_KH_ChoSauThatBai" />
    <bpmn:sequenceFlow id="Flow_KH_11" sourceRef="Gw_KH_ChoSauThatBai" targetRef="Event_KH_HenGiaoLai" />
    <bpmn:sequenceFlow id="Flow_KH_12" sourceRef="Gw_KH_ChoSauThatBai" targetRef="Event_KH_HuyHoanTien" />
    <bpmn:sequenceFlow id="Flow_KH_13" sourceRef="Event_KH_HenGiaoLai" targetRef="Gw_KH_ChoGiao" />
    <bpmn:sequenceFlow id="Flow_KH_14" sourceRef="Event_KH_HuyHoanTien" targetRef="End_KH_HuyHoanTien" />
    <bpmn:sequenceFlow id="Flow_KH_15" sourceRef="Event_KH_NhanHang" targetRef="Gw_KH_CoPhieu" />
    <bpmn:sequenceFlow id="Flow_KH_CoPhieu" name="có" sourceRef="Gw_KH_CoPhieu" targetRef="Task_KH_NhanPhieu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">duocPhieu100K == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_KH_KhongPhieu" name="không" sourceRef="Gw_KH_CoPhieu" targetRef="End_KH_ThanhCong" />
    <bpmn:sequenceFlow id="Flow_KH_16" sourceRef="Task_KH_NhanPhieu" targetRef="End_KH_ThanhCong" />
  </bpmn:process>
  <bpmn:process id="Process_Hasaki" name="Hasaki giao hàng 2H" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hasaki">
      <bpmn:lane id="Lane_HeThong" name="Hệ thống">
        <bpmn:flowNodeRef>Start_DonHang2H</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhanCongCuaHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LayETA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_SauXacNhanLich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_TruocGiao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DungHan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DuDieuKienDenBu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapPhieu100K</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HuyVaHoanTien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_GiaoDungHan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_GiaoTreDaDenBu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_GiaoTreMienTru</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HuyHetHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HuyHoanTien</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NVCuaHang" name="Nhân viên cửa hàng / kho gần nhất">
        <bpmn:flowNodeRef>Task_CheckTonThucTe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DuTon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XuLyHetHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoiXacNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_KetQuaXacNhanLich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GhiNhanHenLai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GhiNhanChuaXacNhanLich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SoanDongGoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BanGiaoShipper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoanHangVeCH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LienHeHenGiaoLai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GiaoLaiHayHuy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shipper" name="Shipper">
        <bpmn:flowNodeRef>Task_GiaoHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_KetQuaGiao</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_DonHang2H" name="Đơn hàng 2H được đặt">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="Task_PhanCongCuaHang" name="Phân công cửa hàng / kho gần nhất" />
    <bpmn:task id="Task_LayETA" name="Gắn ETA đã chốt theo giờ đặt" />
    <bpmn:task id="Task_CheckTonThucTe" name="Kiểm tra tồn kho thực tế tại cửa hàng" />
    <bpmn:exclusiveGateway id="Gw_DuTon" name="Đủ tồn thực tế?" default="Flow_HetHang" />
    <bpmn:task id="Task_XuLyHetHang" name="Thông báo khách &#38; hủy đơn (hết hàng thực tế)" />
    <bpmn:endEvent id="End_HuyHetHang" name="Hủy đơn — hết hàng thực tế" />
    <bpmn:task id="Task_GoiXacNhan" name="Gọi xác nhận địa chỉ và thời gian giao" />
    <bpmn:exclusiveGateway id="Gw_KetQuaXacNhanLich" name="Kết quả xác nhận lịch giao?" default="Flow_KhongLienLac" />
    <bpmn:task id="Task_GhiNhanHenLai" name="Ghi nhận khách hẹn lại (miễn trừ voucher)" />
    <bpmn:task id="Task_GhiNhanChuaXacNhanLich" name="Ghi nhận chưa xác nhận lịch — fulfill theo thông tin đơn" />
    <bpmn:exclusiveGateway id="Join_SauXacNhanLich" name="" />
    <bpmn:task id="Task_SoanDongGoi" name="Soạn hàng và đóng gói" />
    <bpmn:task id="Task_BanGiaoShipper" name="Bàn giao đơn cho shipper" />
    <bpmn:exclusiveGateway id="Join_TruocGiao" name="" />
    <bpmn:task id="Task_GiaoHang" name="Giao hàng (gọi khách; ghi log nếu không liên hệ được)" />
    <bpmn:exclusiveGateway id="Gw_KetQuaGiao" name="Giao hàng thành công?" default="Flow_GiaoThatBai" />
    <bpmn:task id="Task_HoanHangVeCH" name="Hoàn hàng về cửa hàng / ghi nhận giao thất bại" />
    <bpmn:task id="Task_LienHeHenGiaoLai" name="Liên hệ khách để hẹn giao lại (trong 3 ngày)" />
    <bpmn:exclusiveGateway id="Gw_GiaoLaiHayHuy" name="Liên hệ được để giao lại?" default="Flow_HetHanHuy" />
    <bpmn:task id="Task_HuyVaHoanTien" name="Hủy đơn &#38; hoàn tiền đã thanh toán (trong 30 ngày)" />
    <bpmn:endEvent id="End_HuyHoanTien" name="Đã hủy đơn và hoàn tiền" />
    <bpmn:exclusiveGateway id="Gw_DungHan" name="Giao đúng hạn ETA gốc?" default="Flow_Tre" />
    <bpmn:endEvent id="End_GiaoDungHan" name="Giao thành công đúng hạn" />
    <bpmn:exclusiveGateway id="Gw_DuDieuKienDenBu" name="Đủ điều kiện phiếu 100K?" default="Flow_MienTru" />
    <bpmn:task id="Task_CapPhieu100K" name="Cộng phiếu 100K vào tài khoản App/Website" />
    <bpmn:endEvent id="End_GiaoTreDaDenBu" name="Giao trễ — đã cộng phiếu vào tài khoản" />
    <bpmn:endEvent id="End_GiaoTreMienTru" name="Giao trễ — miễn trừ đền bù" />
    <bpmn:sequenceFlow id="Flow_H_1" sourceRef="Start_DonHang2H" targetRef="Task_PhanCongCuaHang" />
    <bpmn:sequenceFlow id="Flow_H_2" sourceRef="Task_PhanCongCuaHang" targetRef="Task_LayETA" />
    <bpmn:sequenceFlow id="Flow_H_3" sourceRef="Task_LayETA" targetRef="Task_CheckTonThucTe" />
    <bpmn:sequenceFlow id="Flow_H_4" sourceRef="Task_CheckTonThucTe" targetRef="Gw_DuTon" />
    <bpmn:sequenceFlow id="Flow_DuTon" name="đủ" sourceRef="Gw_DuTon" targetRef="Task_GoiXacNhan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">duTonThucTe == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HetHang" name="không đủ" sourceRef="Gw_DuTon" targetRef="Task_XuLyHetHang" />
    <bpmn:sequenceFlow id="Flow_H_5" sourceRef="Task_XuLyHetHang" targetRef="End_HuyHetHang" />
    <bpmn:sequenceFlow id="Flow_H_6" sourceRef="Task_GoiXacNhan" targetRef="Gw_KetQuaXacNhanLich" />
    <bpmn:sequenceFlow id="Flow_LichOK" name="xác nhận địa chỉ &#38; giữ giờ giao" sourceRef="Gw_KetQuaXacNhanLich" targetRef="Join_SauXacNhanLich">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">giuLichGiaoGoc == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HenLai" name="khách hẹn lại muộn hơn" sourceRef="Gw_KetQuaXacNhanLich" targetRef="Task_GhiNhanHenLai">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">khachHenLaiMuonHon == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_KhongLienLac" name="không liên lạc được" sourceRef="Gw_KetQuaXacNhanLich" targetRef="Task_GhiNhanChuaXacNhanLich" />
    <bpmn:sequenceFlow id="Flow_H_6b" sourceRef="Task_GhiNhanHenLai" targetRef="Join_SauXacNhanLich" />
    <bpmn:sequenceFlow id="Flow_H_6c" sourceRef="Task_GhiNhanChuaXacNhanLich" targetRef="Join_SauXacNhanLich" />
    <bpmn:sequenceFlow id="Flow_H_7" sourceRef="Join_SauXacNhanLich" targetRef="Task_SoanDongGoi" />
    <bpmn:sequenceFlow id="Flow_H_8" sourceRef="Task_SoanDongGoi" targetRef="Task_BanGiaoShipper" />
    <bpmn:sequenceFlow id="Flow_H_9" sourceRef="Task_BanGiaoShipper" targetRef="Join_TruocGiao" />
    <bpmn:sequenceFlow id="Flow_H_10" sourceRef="Join_TruocGiao" targetRef="Task_GiaoHang" />
    <bpmn:sequenceFlow id="Flow_H_11" sourceRef="Task_GiaoHang" targetRef="Gw_KetQuaGiao" />
    <bpmn:sequenceFlow id="Flow_GiaoOK" name="thành công" sourceRef="Gw_KetQuaGiao" targetRef="Gw_DungHan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">trangThaiGiao == "Giao hang thanh cong"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GiaoThatBai" name="không liên hệ được / giao thất bại" sourceRef="Gw_KetQuaGiao" targetRef="Task_HoanHangVeCH" />
    <bpmn:sequenceFlow id="Flow_H_12" sourceRef="Task_HoanHangVeCH" targetRef="Task_LienHeHenGiaoLai" />
    <bpmn:sequenceFlow id="Flow_H_13" sourceRef="Task_LienHeHenGiaoLai" targetRef="Gw_GiaoLaiHayHuy" />
    <bpmn:sequenceFlow id="Flow_GiaoLai" name="hẹn được — giao lại" sourceRef="Gw_GiaoLaiHayHuy" targetRef="Join_TruocGiao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">henGiaoLaiThanhCong == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HetHanHuy" name="hết 3 ngày vẫn không liên lạc được" sourceRef="Gw_GiaoLaiHayHuy" targetRef="Task_HuyVaHoanTien" />
    <bpmn:sequenceFlow id="Flow_H_14" sourceRef="Task_HuyVaHoanTien" targetRef="End_HuyHoanTien" />
    <bpmn:sequenceFlow id="Flow_DungHan" name="đúng hạn" sourceRef="Gw_DungHan" targetRef="End_GiaoDungHan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">giaoDungHan == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Tre" name="trễ hơn ETA gốc" sourceRef="Gw_DungHan" targetRef="Gw_DuDieuKienDenBu" />
    <bpmn:sequenceFlow id="Flow_DenBuYes" name="đủ điều kiện" sourceRef="Gw_DuDieuKienDenBu" targetRef="Task_CapPhieu100K">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nowFreeMienPhi == true &amp;&amp; khachHenLaiMuonHon == false &amp;&amp; daGiaoLaiSauKhongLienHe == false &amp;&amp; khongBatKhaKhang == true &amp;&amp; khongLoiNguoiNhan == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MienTru" name="miễn trừ" sourceRef="Gw_DuDieuKienDenBu" targetRef="End_GiaoTreMienTru" />
    <bpmn:sequenceFlow id="Flow_H_15" sourceRef="Task_CapPhieu100K" targetRef="End_GiaoTreDaDenBu" />
    <bpmn:textAnnotation id="Note_Trigger">
      <bpmn:text>Trigger: đơn đã được App cho phép chọn 2H. Phí &amp; ETA gốc đã chốt lúc đặt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_NoteTrigger" sourceRef="Start_DonHang2H" targetRef="Note_Trigger" />
    <bpmn:textAnnotation id="Note_CuocGoi">
      <bpmn:text>NV gọi để xác nhận địa chỉ và thời gian giao. Không liên lạc được → ghi nhận + vẫn soạn/giao theo địa chỉ &amp; ETA trên đơn; shipper gọi lại khi giao. Khách hẹn lại muộn hơn → miễn trừ voucher.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_NoteCuocGoi" sourceRef="Task_GoiXacNhan" targetRef="Note_CuocGoi" />
    <bpmn:textAnnotation id="Note_GiaoThatBai">
      <bpmn:text>Theo quy trình giao hàng Hasaki: lần 1 không nhận được → liên hệ hẹn giao lại; không liên lạc được trong 3 ngày → hủy đơn và hoàn tiền đã thanh toán trong 30 ngày. Không liên hệ được khi giao = lỗi phía người nhận → không voucher 100K.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_NoteGiaoThatBai" sourceRef="Task_LienHeHenGiaoLai" targetRef="Note_GiaoThatBai" />
    <bpmn:textAnnotation id="Note_Voucher">
      <bpmn:text>Phiếu 100K cộng vào tài khoản App/Website. Không áp dụng nếu hẹn lại, giao lại sau không liên hệ được, bất khả kháng, hoặc lỗi người nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_NoteVoucher" sourceRef="Task_CapPhieu100K" targetRef="Note_Voucher" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_VanChuyen2H">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_VanChuyen2H" bpmnElement="Collab_VanChuyen2H">
      <bpmndi:BPMNShape id="BPMNShape_Pool_KhachHang" bpmnElement="Pool_KhachHang" isHorizontal="true">
        <dc:Bounds x="2138" y="1926" width="1604" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Pool_Hasaki" bpmnElement="Pool_Hasaki" isHorizontal="true">
        <dc:Bounds x="310" y="80" width="3432" height="1766" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_DatHang" bpmnElement="Msg_DatHang">
        <di:waypoint x="2394" y="1966" />
        <di:waypoint x="2394" y="1886" />
        <di:waypoint x="398" y="1886" />
        <di:waypoint x="398" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="784" y="1864" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_GoiXacNhan" bpmnElement="Msg_GoiXacNhan">
        <di:waypoint x="1316" y="1206" />
        <di:waypoint x="1316" y="1886" />
        <di:waypoint x="2712" y="1886" />
        <di:waypoint x="2712" y="1988" />
